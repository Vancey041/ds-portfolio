{"version":3,"kind":"Notebook","sha256":"693075c406ff6d59c1a052c6c0927efb19819546a6e0fcd774dd06a3168cd6f0","slug":"laboratory-task-2-01-understanding-deep-learning","location":"/Laboratory Task 2 (01_Understanding Deep Learning).ipynb","dependencies":[],"frontmatter":{"kernelspec":{"name":"conda-base-py","display_name":"Python [conda env:base] *","language":"python"},"numbering":{"title":{"offset":1}},"exports":[{"format":"ipynb","filename":"Laboratory Task 2 (01_Understanding Deep Learning).ipynb","url":"/ds-portfolio/build/Laboratory Task 2 (0-e6fa237418d13d376c90294a6f0487b7.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"div","class":"alert alert-block alert-success","style":{"fontFamily":"Times New Roman"},"children":[{"type":"heading","depth":2,"children":[{"type":"strong","children":[{"type":"text","value":"Laboratory Task 2","key":"RdTcismhwQ"}],"key":"z1fOb9mB9y"}],"identifier":"laboratory-task-2","label":"Laboratory Task 2","html_id":"laboratory-task-2","implicit":true,"key":"GNfv3nMt0p"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Instruction:","key":"IDNfhI7ank"}],"key":"nxQO1caEqN"},{"type":"text","value":" Perform a single forward pass and compute for the error.","key":"bGQGguShAI"}],"key":"aldqd5h293"},{"type":"div","class":"math-display","children":[{"type":"text","value":"x = \\begin{bmatrix} 1 \\\\ 0 \\\\ 1 \\end{bmatrix}","key":"j1cGefKLpS"}],"key":"VJJnYNQOem"},{"type":"div","class":"math-display","children":[{"type":"text","value":"y = \\begin{bmatrix} 1 \\end{bmatrix}","key":"Jzm8oKnRdl"}],"key":"Ud7d1yRLc2"},{"type":"div","class":"math-display","children":[{"type":"text","value":"f=max(0, Z_n)","key":"q82h2TG9YT"}],"key":"iwpJpQlAV9"},{"type":"code","lang":"python","meta":null,"value":"\\text{hidden unit weights} = \n\\begin{bmatrix}\nw_{11} = 0.2 && w_{12} = -0.3 \\\\\nw_{13} = 0.4 && w_{14} = 0.1 \\\\\nw_{15} = -0.5 && w_{16} = 0.2\n\\end{bmatrix}","key":"OlsyzQiSqT"},{"type":"code","lang":"python","meta":null,"value":"\\text{output unit weights} = \n\\begin{bmatrix}\nw_{21} = -0.3 \\\\\nw_{22} = -0.2\n\\end{bmatrix}","key":"Cx8uZm4PsX"},{"type":"code","lang":"python","meta":null,"value":"\\theta = \n\\begin{bmatrix}\n\\theta_{1} = -0.4 \\\\\n\\theta_{2} = 0.2 \\\\\n\\theta_{3} = 0.1\n\\end{bmatrix}","key":"LKwho9cKdg"}],"key":"jKYdG1ZwFf"}],"key":"e50ilouQGJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# Inputs and Targets\nx = np.array([1, 0, 1])\ny = np.array([1])\n\n# Weights and Biases\nw_hidden = np.array([[ 0.2, -0.3],\n                     [ 0.4,  0.1],\n                     [-0.5,  0.2]])\n\nw_output = np.array([-0.3, -0.2])\n\ntheta_hidden = np.array([-0.4, 0.2])\ntheta_output = np.array([0.1])\n\n# Hidden Layer Forward Pass\nZ_hidden = np.dot(x, w_hidden) + theta_hidden\nH = np.maximum(0, Z_hidden)  # ReLU activation\n\n# Output Layer Forward Pass\nZ_output = np.dot(H, w_output) + theta_output\ny_hat = np.maximum(0, Z_output)  # ReLU activation\n\n# Error Calculation\ndelta = y_hat - y\n\nprint(f\"Hidden Layer Activations (H): {H}\")\nprint(f\"Predicted Output (y_hat): {y_hat}\")\nprint(f\"Error (delta): {delta}\")","key":"s5DuWqz9iT"},{"type":"outputs","id":"WkO65ti0h1dfUPzUYqFpP","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Hidden Layer Activations (H): [0.  0.1]\nPredicted Output (y_hat): [0.08]\nError (delta): [-0.92]\n"},"children":[],"key":"GworXKMOog"}],"key":"Km4S3kABas"}],"key":"gXa4Rgyagl"}],"key":"osKQwraXRN"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"My Laboratory Tasks","url":"/notebooks","group":"Personal Portfolio"},"next":{"title":"Laboratory   Task  3 (01 Understanding   Deep   Learning )","url":"/laboratory-task-3-01-understanding-deep-learning","group":"Personal Portfolio"}}},"domain":"http://localhost:3000"}