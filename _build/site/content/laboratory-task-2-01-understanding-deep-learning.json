-0.3 \\\\\nw_{13} = 0.4 && w_{14} = 0.1 \\\\\nw_{15} = -0.5 && w_{16} = 0.2\n\\end{bmatrix}","key":"X6o4wQZJjq"},{"type":"code","lang":"python","meta":null,"value":"\\text{output unit weights} = \n\\begin{bmatrix}\nw_{21} = -0.3 \\\\\nw_{22} = -0.2\n\\end{bmatrix}","key":"ZBGasHXyAa"},{"type":"code","lang":"python","meta":null,"value":"\\theta = \n\\begin{bmatrix}\n\\theta_{1} = -0.4 \\\\\n\\theta_{2} = 0.2 \\\\\n\\theta_{3} = 0.1\n\\end{bmatrix}","key":"JrWDNRujMC"}],"key":"UbWYz1OlTu"}],"key":"pbpd2YiduF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Setup and Input Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"di7sKpEZDh"}],"identifier":"id-1-setup-and-input-data","label":"1. Setup and Input Data","html_id":"id-1-setup-and-input-data","implicit":true,"key":"KiNdFbpydz"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This section initializes the environment and the data. We import NumPy to handle the matrix math required for neural networks. We then define our input vector x (containing three features) and our target label y (the correct answer the network is trying to guess).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WIXh8hNB50"}],"key":"ffeTNxBr7w"}],"key":"IQjcrGPYDc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# Inputs and Targets\nx = np.array([1, 0, 1])\ny = np.array([1])","key":"smv9Awh9jr"},{"type":"outputs","id":"rEC3kix7tcMRULItoSnBA","children":[],"key":"NUWMeIJpN3"}],"key":"qQ2CFUQUdC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Initializing Weights and Biases","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Kar6HKx9L6"}],"identifier":"id-2-initializing-weights-and-biases","label":"2. Initializing Weights and Biases","html_id":"id-2-initializing-weights-and-biases","implicit":true,"key":"mSXtezTurR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here, we construct the architecture of the network by defining its parameters. w_hidden is a 3x2 matrix because it maps our 3 inputs to 2 hidden nodes. w_output maps those 2 hidden nodes to a single output prediction. The theta variables are the biases, which act as constants added to each node to shift the activation function left or right.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"d1imv47I67"}],"key":"AKxUHc5rTJ"}],"key":"wY3t2jfvj4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Weights and Biases\nw_hidden = np.array([[ 0.2, -0.3],\n                     [ 0.4,  0.1],\n                     [-0.5,  0.2]])\n\nw_output = np.array([-0.3, -0.2])\n\ntheta_hidden = np.array([-0.4, 0.2])\ntheta_output = np.array([0.1])","key":"dMH0seS1wf"},{"type":"outputs","id":"FFHPTKKz_oYfDKAjP_YJy","children":[],"key":"Q1p6CKi83b"}],"key":"nTDbyRXsMc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Computing the Hidden Layer (Forward Pass)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R4SanBLpwQ"}],"identifier":"id-3-computing-the-hidden-layer-forward-pass","label":"3. Computing the Hidden Layer (Forward Pass)","html_id":"id-3-computing-the-hidden-layer-forward-pass","implicit":true,"key":"aNMLzwQCG6"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This is the first computational step of the forward pass. np.dot(x, w_hidden) calculates the weighted sum of the inputs, and theta_hidden is added to complete the linear transformation (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"q9FH11JD0h"},{"type":"inlineMath","value":"Z","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>Z</mi></mrow><annotation encoding=\"application/x-tex\">Z</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.07153em;\">Z</span></span></span></span>","key":"F7xmCc5pwI"},{"type":"text","value":"). We then apply the ReLU (Rectified Linear Unit) non-linear activation function using np.maximum(0, Z_hidden). This converts any negative pre-activation values to zero, determining which signals pass through to the next layer.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aOgmdNcXdA"}],"key":"pscDZcsnDH"}],"key":"XFlgH00ni4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Hidden Layer Forward Pass\nZ_hidden = np.dot(x, w_hidden) + theta_hidden\nH = np.maximum(0, Z_hidden)  # ReLU activation","key":"SscmheRFsQ"},{"type":"outputs","id":"_ZojygVC58TZlW5_nXtL8","children":[],"key":"IhlTu7EgT9"}],"key":"TlLPtuVI4m"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Computing the Output Layer (Forward Pass)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"maJqEfnxsO"}],"identifier":"id-4-computing-the-output-layer-forward-pass","label":"4. Computing the Output Layer (Forward Pass)","html_id":"id-4-computing-the-output-layer-forward-pass","implicit":true,"key":"NNpME4WskV"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The network uses the surviving signals from the hidden layer (H) as the inputs for the final layer. It computes the dot product of H and the output weights, adds the output bias, and applies the ReLU activation function one last time to generate the network’s final prediction, y_hat.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eNx4f4LubP"}],"key":"RIxLyHHfy0"}],"key":"yCndZo41wW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Output Layer Forward Pass\nZ_output = np.dot(H, w_output) + theta_output\ny_hat = np.maximum(0, Z_output)  # ReLU activation","key":"wLU962fCP0"},{"type":"outputs","id":"m49MBY6mmLf7bQUWVETzj","children":[],"key":"uL6kq0kj0I"}],"key":"THryK3CLu4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Error Calculation and Output","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vd2kH8yE8o"}],"identifier":"id-5-error-calculation-and-output","label":"5. Error Calculation and Output","html_id":"id-5-error-calculation-and-output","implicit":true,"key":"CsW2WWCdA2"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"To determine how well the network performed, we calculate the raw difference (delta) between the prediction (y_hat) and the actual target (y). In a full training loop, this negative or positive delta would be passed backward through the network to adjust the weights. Finally, the script prints the intermediate activations and the final error.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Aqmi8Ksmnu"}],"key":"rqfCel20rZ"}],"key":"OtmvvMyDHx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Error Calculation\ndelta = y_hat - y\n\nprint(f\"Hidden Layer Activations (H): {H}\")\nprint(f\"Predicted Output (y_hat): {y_hat}\")\nprint(f\"Error (delta): {delta}\")","key":"eI3rq3Z8w4"},{"type":"outputs","id":"cm5Yt3Sqqmi7syOyTGdZB","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Hidden Layer Activations (H): [0.  0.1]\nPredicted Output (y_hat): [0.08]\nError (delta): [-0.92]\n"},"children":[],"key":"xoAVGMhaaF"}],"key":"gD7mbDWEBP"}],"key":"t3bVz4S5sx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Hidden Layer Activation Dynamics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BmErcMHRYC"}],"key":"Iwp2AfTkl9"},{"type":"text","value":" (H = [0.0, 0.1])The output reveals how the Rectified Linear Unit (ReLU) activation function controls the network’s signal flow. The pre-activation sum for the first hidden node results in a negative value (-0.7). Because ReLU is defined as ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BnjOO4i79I"},{"type":"inlineMath","value":"max(0, Z_n)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>m</mi><mi>a</mi><mi>x</mi><mo stretchy=\"false\">(</mo><mn>0</mn><mo separator=\"true\">,</mo><msub><mi>Z</mi><mi>n</mi></msub><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">max(0, Z_n)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">ma</span><span class=\"mord mathnormal\">x</span><span class=\"mopen\">(</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.07153em;\">Z</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">n</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span></span></span></span>","key":"QiitfiVwJq"},{"type":"text","value":", it completely deactivates this neuron, resulting in a 0.0 output. The second hidden node yields a positive pre-activation sum (0.1), allowing the signal to pass through unchanged. This demonstrates ReLU’s role in introducing non-linearity by dropping negative signals.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JbMLTYuP0L"}],"key":"jXb7gwWn5u"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Output Layer Prediction","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"c807U1d8ci"}],"key":"ECDWZRlOm8"},{"type":"text","value":" (y_hat = [0.08])The final prediction heavily depends on the surviving signals from the hidden layer. Since the first hidden node outputted a 0, its corresponding weight (-0.3) is completely neutralized. The output calculation essentially becomes a combination of the second hidden node’s signal (0.1) multiplied by its weight (-0.2), added to the output bias (0.1). This results in a final network prediction of 0.08.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"v3DQt1fSt5"}],"key":"fMvNIic6Pp"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Error Differential","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ls2EQHmWoW"}],"key":"t7AYKIGTZB"},{"type":"text","value":" (delta = [-0.92])The error calculation (","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"sNiwN3Rkq1"},{"type":"inlineMath","value":"\\delta = \\hat{y} - y","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>δ</mi><mo>=</mo><mover accent=\"true\"><mi>y</mi><mo>^</mo></mover><mo>−</mo><mi>y</mi></mrow><annotation encoding=\"application/x-tex\">\\delta = \\hat{y} - y</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03785em;\">δ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord accent\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">y</span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.1944em;\"><span class=\"mord\">^</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1944em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">y</span></span></span></span>","key":"MpaubvCzhm"},{"type":"text","value":") represents the raw mathematical difference between the network’s prediction (0.08) and the actual target (1.0). The resulting delta of -0.92 indicates a significant underestimation by the network. Because the weights and biases were arbitrarily initialized, this high error rate is expected. In a complete training loop, this negative delta serves as the starting gradient for backpropagation, signaling the network to increase the weights and biases in the preceding layers to drive the next prediction closer to 1.0.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"BUOQDZBkA4"}],"key":"AHoW8Ld8qS"}],"key":"KWzfhcErYb"}],"key":"JfHGwrrvgT"},"references":{"cite":{"order":[],"data":{}}}}