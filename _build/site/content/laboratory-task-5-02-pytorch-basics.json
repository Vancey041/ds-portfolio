"BCFxLPZH12"},{"type":"text","value":"There are several ways to do this.","key":"qe0FBlQ0sK"}],"key":"HlEPNkBzBX"},{"type":"break","key":"KZAIiGq6RO"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"9. Create a tensor ","key":"YP9JbHmWQ3"},{"type":"inlineCode","value":"y","key":"ydF2c1l9rT"},{"type":"text","value":" with the same number of elements as ","key":"eMkO9lh67u"},{"type":"inlineCode","value":"x","key":"lQM7sXLuEp"},{"type":"text","value":", that can be matrix-multiplied with ","key":"yguRWA14Pl"},{"type":"inlineCode","value":"x","key":"NWwZVg2g35"}],"key":"pf3AyyIfKq"},{"type":"text","value":" ","key":"nfVPcnEsDv"},{"type":"break","key":"YMa2HxlV3k"},{"type":"text","value":"Use PyTorch directly (not NumPy) to create a tensor of random integers between 0 (inclusive) and 5 (exclusive). Use 42 as seed. ","key":"HkJInTzoib"},{"type":"break","key":"vvyuuTwMOP"},{"type":"text","value":"Think about what shape it should have to permit matrix multiplication.","key":"VxEG8RkhvX"}],"key":"W7Ig0xPNhk"},{"type":"break","key":"xKjLKrQpn1"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"10. Find the matrix product of ","key":"XjLy4GSoGQ"},{"type":"inlineCode","value":"x","key":"fwdcGjJcPL"},{"type":"text","value":" and ","key":"b4ONpgLKDT"},{"type":"inlineCode","value":"y","key":"CUaCZy57pJ"},{"type":"text","value":".","key":"eeWUhRgRzA"}],"key":"rKwobxtLzF"}],"key":"jnutLHUh7J"}],"key":"HSpvkXf4Kq"}],"key":"zWbemg8SnH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Perform Standard Imports\nimport numpy as np\nimport torch\n\n# 2. Create a function called set_seed()\ndef set_seed(seed: int):\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n\n# 3. Create a NumPy array \nset_seed(42)\narr = np.random.randint(0, 5, 6)\n\n# 4. Create a tensor \"x\" from the array above\nx = torch.from_numpy(arr)\n\n# 5. Change the dtype of x from int32 to int64\nx = x.type(torch.int64)\n\n# 6. Reshape x into a 3x2 tensor\nx = x.reshape(3, 2)\n\n# 7. Return the right-hand column of tensor x\nright_column = x[:, 1:] \n\n# 8. Without changing x, return a tensor of square values of x\nx_squared = x.pow(2) \n\n# 9. Create a tensor y with the same number of elements as x, that can be matrix-multiplied with x\nset_seed(42)\ny = torch.randint(0, 5, (2, 3))\n\n# 10. Find the matrix product of x and y\nmatrix_prod = torch.mm(x, y) \n\n# Print statements to verify the outputs\nprint(\"x:\\n\", x)\nprint(\"\\nright_column:\\n\", right_column)\nprint(\"\\nx_squared:\\n\", x_squared)\nprint(\"\\ny:\\n\", y)\nprint(\"\\nMatrix Product (x * y):\\n\", matrix_prod)","key":"SKd9MQv2rA"},{"type":"outputs","id":"u6a5oxbUISQ1yHOlG_k4m","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"x:\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n\nright_column:\n tensor([[4],\n        [4],\n        [1]])\n\nx_squared:\n tensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\ny:\n tensor([[2, 2, 1],\n        [4, 1, 0]])\n\nMatrix Product (x * y):\n tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\n"},"children":[],"key":"YAuDVPBhGC"}],"key":"GT87aiuK6n"}],"key":"F3Gue2qtTz"}],"key":"XNDPtuaD2Q"},"references":{"cite":{"order":[],"data":{}}}}