"WuhjlIyxZ1"},{"type":"text","value":"There are several ways to do this.","key":"eixLvmr3QP"}],"key":"HSJhKt5eAE"},{"type":"break","key":"VEPXlJ9HQN"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"9. Create a tensor ","key":"Mp5ZxwSVuZ"},{"type":"inlineCode","value":"y","key":"c2k2vjHNGj"},{"type":"text","value":" with the same number of elements as ","key":"v46ZVjKnry"},{"type":"inlineCode","value":"x","key":"vY54LY6vVa"},{"type":"text","value":", that can be matrix-multiplied with ","key":"N7s4m0vaYA"},{"type":"inlineCode","value":"x","key":"MsBC2SjnPS"}],"key":"l1as87ekn4"},{"type":"text","value":" ","key":"MGYIicxoGQ"},{"type":"break","key":"Plsw2OSRTr"},{"type":"text","value":"Use PyTorch directly (not NumPy) to create a tensor of random integers between 0 (inclusive) and 5 (exclusive). Use 42 as seed. ","key":"suLFZ9VwgB"},{"type":"break","key":"ewebogUJ4P"},{"type":"text","value":"Think about what shape it should have to permit matrix multiplication.","key":"uH29UejIe7"}],"key":"FkurVOnUCv"},{"type":"break","key":"vRTnuRynwI"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"10. Find the matrix product of ","key":"qkTEsQF11A"},{"type":"inlineCode","value":"x","key":"J6fafWgChK"},{"type":"text","value":" and ","key":"ssF4EbmjdD"},{"type":"inlineCode","value":"y","key":"fSeGvAeBVd"},{"type":"text","value":".","key":"usEDON9Rzu"}],"key":"NsMcGCeTdo"}],"key":"FDIHJ0wzhD"}],"key":"i3iL4djgUn"}],"key":"OswAgd6kYt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Perform Standard Imports\nimport numpy as np\nimport torch\n\n# 2. Create a function called set_seed()\ndef set_seed(seed: int):\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n\n# 3. Create a NumPy array \nset_seed(42)\narr = np.random.randint(0, 5, 6)\n\n# 4. Create a tensor \"x\" from the array above\nx = torch.from_numpy(arr)\n\n# 5. Change the dtype of x from int32 to int64\nx = x.type(torch.int64)\n\n# 6. Reshape x into a 3x2 tensor\nx = x.reshape(3, 2)\n\n# 7. Return the right-hand column of tensor x\nright_column = x[:, 1:] \n\n# 8. Without changing x, return a tensor of square values of x\nx_squared = x.pow(2) \n\n# 9. Create a tensor y with the same number of elements as x, that can be matrix-multiplied with x\nset_seed(42)\ny = torch.randint(0, 5, (2, 3))\n\n# 10. Find the matrix product of x and y\nmatrix_prod = torch.mm(x, y) \n\n# Print statements to verify the outputs\nprint(\"x:\\n\", x)\nprint(\"\\nright_column:\\n\", right_column)\nprint(\"\\nx_squared:\\n\", x_squared)\nprint(\"\\ny:\\n\", y)\nprint(\"\\nMatrix Product (x * y):\\n\", matrix_prod)","key":"ZDLLiSJPdU"},{"type":"outputs","id":"OdjrBTndhOKSvA9MGymcG","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"x:\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n\nright_column:\n tensor([[4],\n        [4],\n        [1]])\n\nx_squared:\n tensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\ny:\n tensor([[2, 2, 1],\n        [4, 1, 0]])\n\nMatrix Product (x * y):\n tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\n"},"children":[],"key":"lTTRB5iw49"}],"key":"NbBJRubnUj"}],"key":"UvS3iZwF9S"}],"key":"EaNs1d8nGK"},"references":{"cite":{"order":[],"data":{}}}}