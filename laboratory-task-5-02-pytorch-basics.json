ype":"break","key":"Nxd8sPpQmx"},{"type":"text","value":"There are several ways to do this.","key":"WMe2ULTZzA"}],"key":"IVhVftGuYt"},{"type":"break","key":"ytDyb7yJgg"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"9. Create a tensor ","key":"zjyUSRCuFG"},{"type":"inlineCode","value":"y","key":"GBADud4zPB"},{"type":"text","value":" with the same number of elements as ","key":"gmjN4DAiEZ"},{"type":"inlineCode","value":"x","key":"fpOmWf4FLl"},{"type":"text","value":", that can be matrix-multiplied with ","key":"AxkghvMrQW"},{"type":"inlineCode","value":"x","key":"bdohBqU1rL"}],"key":"IO3ALFehtq"},{"type":"text","value":" ","key":"OissBv1Cll"},{"type":"break","key":"xQvDJs9abr"},{"type":"text","value":"Use PyTorch directly (not NumPy) to create a tensor of random integers between 0 (inclusive) and 5 (exclusive). Use 42 as seed. ","key":"NzkwHAWVKT"},{"type":"break","key":"YaUioQ3dw9"},{"type":"text","value":"Think about what shape it should have to permit matrix multiplication.","key":"aKly0yYITu"}],"key":"Ybq7wCgiX0"},{"type":"break","key":"kebSCZ22VA"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"10. Find the matrix product of ","key":"YevwGE27jN"},{"type":"inlineCode","value":"x","key":"fReEPbCFDB"},{"type":"text","value":" and ","key":"LAM3mLPfCd"},{"type":"inlineCode","value":"y","key":"wn751uQvQm"},{"type":"text","value":".","key":"iyDbtwLI2t"}],"key":"UXzFCffYM3"}],"key":"STGL1IibZQ"}],"key":"oect9kn130"}],"key":"CrViaPZCaG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Perform Standard Imports\nimport numpy as np\nimport torch\n\n# 2. Create a function called set_seed()\ndef set_seed(seed: int):\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n\n# 3. Create a NumPy array \nset_seed(42)\narr = np.random.randint(0, 5, 6)\n\n# 4. Create a tensor \"x\" from the array above\nx = torch.from_numpy(arr)\n\n# 5. Change the dtype of x from int32 to int64\nx = x.type(torch.int64)\n\n# 6. Reshape x into a 3x2 tensor\nx = x.reshape(3, 2)\n\n# 7. Return the right-hand column of tensor x\nright_column = x[:, 1:] \n\n# 8. Without changing x, return a tensor of square values of x\nx_squared = x.pow(2) \n\n# 9. Create a tensor y with the same number of elements as x, that can be matrix-multiplied with x\nset_seed(42)\ny = torch.randint(0, 5, (2, 3))\n\n# 10. Find the matrix product of x and y\nmatrix_prod = torch.mm(x, y) \n\n# Print statements to verify the outputs\nprint(\"x:\\n\", x)\nprint(\"\\nright_column:\\n\", right_column)\nprint(\"\\nx_squared:\\n\", x_squared)\nprint(\"\\ny:\\n\", y)\nprint(\"\\nMatrix Product (x * y):\\n\", matrix_prod)","key":"Af4yLTBaN4"},{"type":"outputs","id":"HoINlDqnhreSzYPoNIUTm","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"x:\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n\nright_column:\n tensor([[4],\n        [4],\n        [1]])\n\nx_squared:\n tensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\ny:\n tensor([[2, 2, 1],\n        [4, 1, 0]])\n\nMatrix Product (x * y):\n tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\n"},"children":[],"key":"JZlggv72f2"}],"key":"qy1628fKNG"}],"key":"gps2FNo02H"}],"key":"vViDEMH18q"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Laboratory   Task  4 (01 Understanding   Deep   Learning )","url":"/laboratory-task-4-01-understanding-deep-learning","group":"Personal Portfolio"}}},"domain":"http://localhost:3000"}