ype":"break","key":"kqrQHwMB01"},{"type":"text","value":"There are several ways to do this.","key":"SzCgZSQuNv"}],"key":"e3Fd2AiXvC"},{"type":"break","key":"f2ZnyaXwn2"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"9. Create a tensor ","key":"h3Ot6dxCjR"},{"type":"inlineCode","value":"y","key":"cTqJSVQh3F"},{"type":"text","value":" with the same number of elements as ","key":"UhSEvfGdMB"},{"type":"inlineCode","value":"x","key":"fU2ICjfbco"},{"type":"text","value":", that can be matrix-multiplied with ","key":"NGqtgRR4Sx"},{"type":"inlineCode","value":"x","key":"KaiZICd1gW"}],"key":"rXJJLtrcEL"},{"type":"text","value":" ","key":"i57s5r0O5h"},{"type":"break","key":"Rjtmcm88On"},{"type":"text","value":"Use PyTorch directly (not NumPy) to create a tensor of random integers between 0 (inclusive) and 5 (exclusive). Use 42 as seed. ","key":"ctg9q71c4b"},{"type":"break","key":"uqhZT3ZVs5"},{"type":"text","value":"Think about what shape it should have to permit matrix multiplication.","key":"JjLsyv6Sww"}],"key":"XmGSjp3pKS"},{"type":"break","key":"vwRlGeKY42"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"10. Find the matrix product of ","key":"Lh4vimuvYq"},{"type":"inlineCode","value":"x","key":"oKF3swWVS2"},{"type":"text","value":" and ","key":"SI00yGti3C"},{"type":"inlineCode","value":"y","key":"z8CphNXVeQ"},{"type":"text","value":".","key":"VJJzPgXHtM"}],"key":"yzDpIJFgya"}],"key":"ZRLwwdDRyd"}],"key":"zOoNKcsnLO"}],"key":"vw4zqWxL6m"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Perform Standard Imports\nimport numpy as np\nimport torch\n\n# 2. Create a function called set_seed()\ndef set_seed(seed: int):\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n\n# 3. Create a NumPy array \nset_seed(42)\narr = np.random.randint(0, 5, 6)\n\n# 4. Create a tensor \"x\" from the array above\nx = torch.from_numpy(arr)\n\n# 5. Change the dtype of x from int32 to int64\nx = x.type(torch.int64)\n\n# 6. Reshape x into a 3x2 tensor\nx = x.reshape(3, 2)\n\n# 7. Return the right-hand column of tensor x\nright_column = x[:, 1:] \n\n# 8. Without changing x, return a tensor of square values of x\nx_squared = x.pow(2) \n\n# 9. Create a tensor y with the same number of elements as x, that can be matrix-multiplied with x\nset_seed(42)\ny = torch.randint(0, 5, (2, 3))\n\n# 10. Find the matrix product of x and y\nmatrix_prod = torch.mm(x, y) \n\n# Print statements to verify the outputs\nprint(\"x:\\n\", x)\nprint(\"\\nright_column:\\n\", right_column)\nprint(\"\\nx_squared:\\n\", x_squared)\nprint(\"\\ny:\\n\", y)\nprint(\"\\nMatrix Product (x * y):\\n\", matrix_prod)","key":"JaOCxnTKNn"},{"type":"outputs","id":"kWCkwvvnfl6Fk3QGU8r1T","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"x:\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n\nright_column:\n tensor([[4],\n        [4],\n        [1]])\n\nx_squared:\n tensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\ny:\n tensor([[2, 2, 1],\n        [4, 1, 0]])\n\nMatrix Product (x * y):\n tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\n"},"children":[],"key":"Ht0jlNLf0L"}],"key":"zv8Ss6IEK2"}],"key":"zFGC7TE09v"}],"key":"F8uGhf1V4i"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Laboratory   Task  4 (01 Understanding   Deep   Learning )","url":"/laboratory-task-4-01-understanding-deep-learning","group":"Personal Portfolio"}}},"domain":"http://localhost:3000"}