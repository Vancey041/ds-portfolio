ype":"break","key":"j8ClVnFn5C"},{"type":"text","value":"There are several ways to do this.","key":"w5IwOoTdp6"}],"key":"YRQdelyF1r"},{"type":"break","key":"b0PCsQJsCm"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"9. Create a tensor ","key":"YeDFVKHRRg"},{"type":"inlineCode","value":"y","key":"dEUp9vFT4A"},{"type":"text","value":" with the same number of elements as ","key":"WvdSQCxpYr"},{"type":"inlineCode","value":"x","key":"DquClmQjeB"},{"type":"text","value":", that can be matrix-multiplied with ","key":"RW0QC70p1e"},{"type":"inlineCode","value":"x","key":"mElGm2d5RA"}],"key":"K6PUPM9V9a"},{"type":"text","value":" ","key":"LTbXlx7KLj"},{"type":"break","key":"RltGvQZrA6"},{"type":"text","value":"Use PyTorch directly (not NumPy) to create a tensor of random integers between 0 (inclusive) and 5 (exclusive). Use 42 as seed. ","key":"NZ4ERBeDWl"},{"type":"break","key":"oZFJhoaxo1"},{"type":"text","value":"Think about what shape it should have to permit matrix multiplication.","key":"AIqUJ3u3Bc"}],"key":"W1ISqu8x9D"},{"type":"break","key":"b6CjaFUH8d"},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"10. Find the matrix product of ","key":"Ljh2okKQ39"},{"type":"inlineCode","value":"x","key":"AW7ohITAjo"},{"type":"text","value":" and ","key":"dcg80CLs7I"},{"type":"inlineCode","value":"y","key":"vGsDpoX90Q"},{"type":"text","value":".","key":"G64yz50bhL"}],"key":"PD3k7vvPWo"}],"key":"i9x5TEClhz"}],"key":"Rr0btXiUfu"}],"key":"EB5VHay5ms"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Perform Standard Imports\nimport numpy as np\nimport torch\n\n# 2. Create a function called set_seed()\ndef set_seed(seed: int):\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n\n# 3. Create a NumPy array \nset_seed(42)\narr = np.random.randint(0, 5, 6)\n\n# 4. Create a tensor \"x\" from the array above\nx = torch.from_numpy(arr)\n\n# 5. Change the dtype of x from int32 to int64\nx = x.type(torch.int64)\n\n# 6. Reshape x into a 3x2 tensor\nx = x.reshape(3, 2)\n\n# 7. Return the right-hand column of tensor x\nright_column = x[:, 1:] \n\n# 8. Without changing x, return a tensor of square values of x\nx_squared = x.pow(2) \n\n# 9. Create a tensor y with the same number of elements as x, that can be matrix-multiplied with x\nset_seed(42)\ny = torch.randint(0, 5, (2, 3))\n\n# 10. Find the matrix product of x and y\nmatrix_prod = torch.mm(x, y) \n\n# Print statements to verify the outputs\nprint(\"x:\\n\", x)\nprint(\"\\nright_column:\\n\", right_column)\nprint(\"\\nx_squared:\\n\", x_squared)\nprint(\"\\ny:\\n\", y)\nprint(\"\\nMatrix Product (x * y):\\n\", matrix_prod)","key":"ZoiD80JMxy"},{"type":"outputs","id":"hKVYz1aK62Hh0HDiy78bw","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"x:\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n\nright_column:\n tensor([[4],\n        [4],\n        [1]])\n\nx_squared:\n tensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n\ny:\n tensor([[2, 2, 1],\n        [4, 1, 0]])\n\nMatrix Product (x * y):\n tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\n"},"children":[],"key":"DnUuEsuRdT"}],"key":"cP6CP3ULyk"}],"key":"j9lBT3OlwN"}],"key":"oCXgEQlRWV"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Laboratory   Task  4 (01 Understanding   Deep   Learning )","url":"/laboratory-task-4-01-understanding-deep-learning","group":"Personal Portfolio"},"next":{"title":"Laboratory   Task  6 ( E1    CNN  Implementation )","url":"/laboratory-task-6-e1-cnn-implementation","group":"Personal Portfolio"}}},"domain":"http://localhost:3000"}